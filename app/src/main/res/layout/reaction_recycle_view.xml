<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clReactionPopup"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout4"
            android:layout_width="@dimen/_310sdp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/linearLayout11"
                android:layout_width="0dp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="@drawable/reaction_background"
                android:weightSum="7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/emoji1"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:text="😜"
                    android:textColor="#fff"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/emoji2"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="🤣"
                    android:textColor="#fff"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/emoji3"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="😉"
                    android:textColor="#fff"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/emoji4"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="🥰"
                    android:textColor="#fff"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/emoji5"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="😃"
                    android:textColor="#fff"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/emoji6"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="-15dp"
                    android:layout_weight="1"
                    android:text="🤭"
                    android:textColor="#fff"
                    android:textSize="30sp" />

                <ImageView
                    android:id="@+id/emoji7"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_plus"
                    android:textColor="#fff" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/optionButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_200sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout11">

                <RelativeLayout
                    android:id="@+id/clMessageSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@+id/messageLayout"
                        android:layout_marginEnd="-52dp"
                        android:layout_toStartOf="@+id/messageLayout"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/pureWhite"
                            android:textSize="@dimen/_7sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSentDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/pureWhite"
                            android:textSize="@dimen/_7sdp"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvSent" />

                        <TextView
                            android:id="@+id/tvSentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/pureWhite"
                            android:textSize="@dimen/_7sdp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvSentDate" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/messageLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="53dp"
                        android:layout_marginEnd="@dimen/_8sdp">


                        <TextView
                            android:id="@+id/tvUserSendMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/backgroundsearch"
                            android:backgroundTint="@color/appBlue"
                            android:fontFamily="@font/poppins"
                            android:paddingStart="@dimen/_7sdp"
                            android:paddingTop="@dimen/_8sdp"
                            android:paddingEnd="@dimen/_13sdp"
                            android:paddingBottom="@dimen/_8sdp"
                            android:textColor="@color/pureWhite"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_min="@dimen/_80sdp" />


                        <RelativeLayout
                            android:id="@+id/reactionLayout"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvUserSendMessage">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/greyCircle"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginTop="0.5dp"
                                android:layout_marginEnd="0.5dp"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/Grey"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="0dp" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/whiteCircle"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_alignParentEnd="true"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/white"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="0dp" />

                            <androidx.cardview.widget.CardView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="1.5dp"
                                android:layout_marginBottom="1.5dp"
                                app:cardBackgroundColor="@color/Grey"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="0dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="1dp"
                                    app:cardBackgroundColor="@color/white"
                                    app:cardCornerRadius="50dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/emoji"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:textColor="#fff"
                                        android:textSize="15dp" />

                                </androidx.cardview.widget.CardView>


                            </androidx.cardview.widget.CardView>


                        </RelativeLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/messageLayout"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/poppins"
                        android:textAllCaps="true"
                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_9sdp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/clMessageReceiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/messageLayout1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="60dp">


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/relativeLayout2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:paddingEnd="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvUserMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/backgroundsearch"
                                android:fontFamily="@font/poppins"
                                android:paddingStart="@dimen/_13sdp"
                                android:paddingTop="@dimen/_8sdp"
                                android:paddingEnd="@dimen/_13sdp"
                                android:paddingBottom="@dimen/_8sdp"
                                android:textColor="@color/pureWhite"
                                android:textSize="16sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintWidth_min="@dimen/_80sdp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>


                        <TextView
                            android:id="@+id/tvReplyDates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/messageLayout1"
                            android:layout_alignEnd="@+id/messageLayout1"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="true"
                            android:textColor="@color/pureWhite"
                            android:textSize="@dimen/_9sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/relativeLayout2" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:textColor="@color/Grey2"
                        android:textSize="@dimen/_11sdp" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/clSenderImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <RelativeLayout
                        android:id="@+id/messageLayout2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="@dimen/_8sdp">


                        <LinearLayout
                            android:id="@+id/llImage"
                            android:layout_width="@dimen/_110sdp"
                            android:layout_height="@dimen/_160sdp"
                            android:layout_marginEnd="@dimen/_8sdp"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            tools:ignore="RtlSymmetry">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cvImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="@color/appBlue"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/senderImage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>


                        <RelativeLayout
                            android:id="@+id/reactionLayout02"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:visibility="gone">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/greyCircle02"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginTop="0.5dp"
                                android:layout_marginEnd="0.5dp"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/Grey2"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="0dp" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/whiteCircle02"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_alignParentEnd="true"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/white"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="0dp" />

                            <androidx.cardview.widget.CardView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="1.5dp"
                                android:layout_marginBottom="1.5dp"
                                app:cardBackgroundColor="@color/Grey2"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="0dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="1dp"
                                    app:cardBackgroundColor="@color/white"
                                    app:cardCornerRadius="50dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/emojiImage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="😜"
                                        android:textColor="#fff"
                                        android:textSize="15dp" />

                                </androidx.cardview.widget.CardView>


                            </androidx.cardview.widget.CardView>


                        </RelativeLayout>

                    </RelativeLayout>


                    <TextView
                        android:id="@+id/tvDateImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/messageLayout2"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/poppins"
                        android:textAllCaps="true"
                        android:textColor="@color/Grey2"
                        android:textSize="@dimen/_9sdp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/clImageReceiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clUserDp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_7sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@color/black"
                        android:elevation="0dp"
                        app:layout_constraintStart_toStartOf="parent">

                        <LinearLayout
                            android:id="@+id/llImages"
                            android:layout_width="@dimen/_110sdp"
                            android:layout_height="@dimen/_160sdp"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:ignore="RtlSymmetry">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cvImages"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="@color/lightblack2"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/receiveOtherImage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDateReceiver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/clUserDp"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="true"
                            android:textColor="@color/pureWhite"
                            android:textSize="@dimen/_9sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/llImages" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/linearLayout10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:padding="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionButton">

                <TextView
                    android:id="@+id/tvReply"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:background="@drawable/reaction_background"
                    android:backgroundTint="@color/bottomsheet_bg_color"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Reply"
                    android:textColor="@color/pureWhite"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvCopy"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvCopy"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:background="@drawable/reaction_background"
                    android:backgroundTint="@color/bottomsheet_bg_color"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Copy"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tvUnSendMessage"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:background="@drawable/reaction_background"
                    android:backgroundTint="@color/bottomsheet_bg_color"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:text="Unsend"
                    android:textColor="@color/RedColor"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvCopy"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
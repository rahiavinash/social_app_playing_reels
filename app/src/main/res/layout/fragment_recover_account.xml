<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root"
        android:background="@color/black">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="25dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:src="@drawable/back"/>





        <TextView
            android:id="@+id/recover_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recover My Account"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/back_button" />


        <TextView
            android:id="@+id/enter_recovery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:text="Enter your Recovery Code"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recover_text" />



        <androidx.cardview.widget.CardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/label"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginStart="@dimen/_16sdp"
            app:cardBackgroundColor="@color/bottomsheet_bg_color"
            app:cardCornerRadius="@dimen/_30sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/enter_recovery_text"
            tools:ignore="NotSibling">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_12sdp">

            <EditText
                android:id="@+id/recovery_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:fontFamily="@font/poppins"
                android:hint="Code"
                android:textCursorDrawable="@drawable/pointer_background"
                android:inputType="text"
                android:maxLines="1"
                android:maxLength="50"
                android:imeOptions="actionDone"
                android:paddingHorizontal="@dimen/_7sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/unselectedColor"
                android:textSize="@dimen/_12sdp" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/copy_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="@dimen/_13sdp"
            android:text="You can copy your code from where you saved it and paste it above. "
            app:layout_constraintTop_toBottomOf="@id/searchCard"
            android:layout_marginStart="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_40sdp"
            android:gravity="center"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/_20sdp"/>


        <TextView
            android:id="@+id/recover_Change_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="@dimen/_15sdp"
            android:text="Tap Recover to login\n and\n CHANGE PASSWORD  "
            app:layout_constraintBottom_toTopOf="@id/recover_button"
            android:layout_marginStart="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_40sdp"
            android:gravity="center"
            android:layout_marginBottom="@dimen/_20sdp"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/_20sdp"/>



        <TextView
            android:id="@+id/recover_button"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_35sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_60sdp"
            android:text="Recover"
            android:paddingTop="2dp"
            android:background="@drawable/white_button_background_two"
            android:textSize="@dimen/_14sdp"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginBottom="@dimen/_60sdp"
            android:textColor="@color/Grey"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
</androidx.recyclerview.widget.RecyclerView>-->
        <LinearLayout
            android:id="@+id/userNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/relativeLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivRestrictImage"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:src="@drawable/ic_greyuser"
                />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivUserProfileImage"
                android:layout_width="@dimen/_38sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:id="@+id/llUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvArAddedAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:paddingEnd="@dimen/_10sdp"
                        android:textColor="@color/pureWhite"
                        android:textSize="11sp"
                        tools:ignore="RtlSymmetry" />
                    <ImageView
                        android:id="@+id/ivBlueTick"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:layout_gravity="end"
                        android:visibility="gone"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:layout_toEndOf="@id/tvArAddedAmount"
                        android:src="@drawable/bluetick"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/tvComma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/_20sdp"
                        android:text=","
                        android:visibility="gone"
                        android:gravity="center"
                        android:layout_toEndOf="@id/ivBlueTick"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/pureWhite"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvSecondUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/_10sdp"
                        android:visibility="gone"
                        android:layout_toEndOf="@id/tvComma"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/pureWhite"
                        android:textSize="13sp"
                        tools:ignore="RtlSymmetry" />

                    <ImageView
                        android:id="@+id/ivBlueTick2"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:layout_gravity="end"
                        android:visibility="gone"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@id/tvSecondUser"
                        android:src="@drawable/bluetick"
                        app:layout_constraintTop_toTopOf="parent" />
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rlRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvRequestStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/_20sdp"
                        android:fontFamily="@font/poppins"

                        android:textColor="@color/pureWhite"
                        android:textSize="11sp" />
                  <!--  <TextView
                        android:id="@+id/tvDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/Grey"
                        android:textSize="@dimen/_9sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_10sdp"
                       />-->
                </RelativeLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/Grey"
                        android:textSize="@dimen/_9sdp"

                        app:layout_constraintEnd_toStartOf="@+id/tvDate"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/Grey"
                        android:textSize="@dimen/_9sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/clCoin"
    android:layout_width="wrap_content"
    android:layout_gravity="center_vertical"
    android:layout_height="wrap_content">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivCoin"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:src="@drawable/exchange_bitcoin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAccept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
android:visibility="gone"
        android:text="Accept"
        android:textColor="@color/appBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivPostImage"
        android:layout_width="@dimen/_38sdp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="@dimen/_45sdp"/>
</androidx.constraintlayout.widget.ConstraintLayout>



            <LinearLayout
                android:layout_width="5dp"
                android:layout_height="match_parent">

            </LinearLayout>


        </LinearLayout>

        </com.apachat.swipereveallayout.core.SwipeLayout>

    </LinearLayout>







</layout>
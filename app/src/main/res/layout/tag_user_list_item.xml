<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_10sdp"
        android:background="@color/bottomsheet_bg_color"
        android:weightSum="1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".55">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileImage"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/profile_dummy"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/Grey"
                    android:text="@string/demo"
                    android:fontFamily="@font/poppins"
                    android:textSize="@dimen/_9sdp"
                    android:id="@+id/username"
                    android:layout_marginBottom="@dimen/_2sdp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_10_followers"
                    android:textColor="@color/Grey"
                    android:fontFamily="@font/poppins"
                    android:textSize="@dimen/_9sdp"
                    android:id="@+id/followCount"/>
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".45"
            android:layout_gravity="center_vertical"
            >
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pureWhite"
                    android:text="@string/_5000"
                    android:fontFamily="@font/poppins"
                    android:textSize="@dimen/_11sdp"
                    android:id="@+id/totalLike"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/Grey"
                    android:text="@string/_5000"
                    android:fontFamily="@font/poppins"
                    android:textSize="@dimen/_9sdp"
                    android:layout_below="@+id/totalLike"
                    android:id="@+id/totalPlay"/>

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/likeImg"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:src="@drawable/ic_like"
                    android:layout_marginStart="@dimen/_4sdp"
                    />
                <ImageView
                    android:layout_width="@dimen/_11sdp"
                    android:layout_height="@dimen/_11sdp"
                    android:src="@drawable/play_blue"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="@dimen/_3sdp"
                    />

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/followBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_9sdp"
                    android:textColor="@color/appBlue"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:text="@string/follow"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
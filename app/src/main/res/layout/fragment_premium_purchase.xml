<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xchange_background"
    tools:context=".mainui.home.exchangescreen.PremiumPurchaseFragment">

    <ImageView
        android:id="@+id/back_button"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/back"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_25sdp"/>

    <ImageView
        android:id="@+id/eighty_image"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:src="@drawable/exchange_eighty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/premium_upgrade_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:fontFamily="@font/poppins"
        android:text="@string/premium_upgrades_text"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eighty_image" />

    <TextView
        android:id="@+id/verified_account_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_35sdp"
        android:fontFamily="@font/poppins"
        android:text="@string/verified_account_text"
        android:textSize="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/premium_upgrade_text" />


    <TextView
        android:id="@+id/four_nine_dollar_button"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="BUY 1 YEAR\n₹ 4,999.00"
        android:background="@drawable/premium_button_background"
        android:gravity="center"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/verified_image_tick"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verified_account_button" />

    <TextView
        android:id="@+id/bonus_verified_one_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/four_nine_dollar_button"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Bonus 1,000 AR"
        android:layout_marginStart="@dimen/_20sdp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_12sdp"/>


    <ImageView
        android:id="@+id/purchased_image_one_year_verified_Tick"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@color/lightblack"
        android:src="@drawable/purchased_image"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verified_account_button"/>

    <ImageView
        android:id="@+id/verified_image_tick"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:src="@drawable/verified_tick_image"
        app:layout_constraintEnd_toStartOf="@+id/one_four_nine_dollar_button"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/four_nine_dollar_button"
        app:layout_constraintTop_toBottomOf="@id/verified_account_button" />

    <TextView
        android:id="@+id/one_four_nine_dollar_button"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="Buy Lifetime\n ₹ 14,900.00"
        android:textSize="@dimen/_12sdp"
        android:background="@drawable/premium_button_background"
        android:gravity="center"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/verified_image_tick"
        app:layout_constraintTop_toBottomOf="@id/verified_account_button" />

    <TextView
        android:id="@+id/bonus_verified_lifetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/one_four_nine_dollar_button"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Bonus 1,000 AR"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_20sdp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_12sdp"/>

    <ImageView
        android:id="@+id/purchased_image_life_time_verified_Tick"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@color/lightblack"
        android:src="@drawable/purchased_image"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintStart_toEndOf="@id/verified_image_tick"
        app:layout_constraintTop_toBottomOf="@id/verified_account_button"/>
    <TextView
        android:id="@+id/moreInfoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/more_info_text"
        android:textColor="@color/appBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verified_image_tick" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verified_account_button"
        android:background="#99090808"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/bonus_verified_lifetime"
        android:textColor="@color/pureWhite"
        android:text="COMING SOON"
        android:textStyle="bold"
        android:textSize="@dimen/_20sdp"/>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:background="#505050"
        app:layout_constraintTop_toBottomOf="@id/moreInfoButton" />


    <TextView
        android:id="@+id/noAdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:textColor="@color/white"
        android:text="@string/no_ads_text"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view" />


    <TextView
        android:id="@+id/textView6"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="Buy 1 year\n ₹ 7,900.00"
        android:textSize="@dimen/_12sdp"
        android:background="@drawable/premium_button_background"
        android:gravity="center"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/adsImage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/noAdText" />

    <TextView
        android:id="@+id/bonus_no_ads_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textView6"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Bonus 1,000 AR"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/_20sdp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_12sdp"/>


    <ImageView
        android:id="@+id/purchased_image_one_year_no_ads"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_7sdp"
        android:background="@color/lightblack"
        android:src="@drawable/purchased_image"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/noAdText" />

    <ImageView
        android:id="@+id/adsImage"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:src="@drawable/ads_sign_image"
        app:layout_constraintEnd_toStartOf="@+id/textView7"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView6"
        app:layout_constraintTop_toBottomOf="@id/noAdText" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="Buy Lifetime\n ₹ 24,900.00"
        android:gravity="center"
        android:textSize="@dimen/_12sdp"
        android:background="@drawable/premium_button_background"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/adsImage"
        app:layout_constraintTop_toBottomOf="@id/noAdText" />


    <TextView
        android:id="@+id/bonus_no_ads_life_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textView6"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Bonus 1,000 AR"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_20sdp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_12sdp"/>


    <ImageView
        android:id="@+id/purchased_image"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@color/lightblack"
        android:src="@drawable/purchased_image"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adsImage"
        app:layout_constraintTop_toBottomOf="@id/noAdText" />

    <TextView
        android:id="@+id/more_info_button_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/more_info_text"
        android:textColor="@color/appBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adsImage" />


    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:background="#505050"
        app:layout_constraintTop_toBottomOf="@id/more_info_button_two" />


    <TextView
        android:id="@+id/ai_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_14sdp"
        android:text="Artificial Intelligence"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view2" />




    <TextView
        android:id="@+id/one_one_nine_text_button"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="Buy 1 year $119.999"
        android:gravity="center"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:background="@drawable/premium_button_background"
        app:layout_constraintEnd_toStartOf="@+id/ai_image"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ai_text_view" />


    <TextView
        android:id="@+id/bonus_ai_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/one_one_nine_text_button"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Bonus 1,000 AR"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/_20sdp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_12sdp"/>


    <ImageView
        android:id="@+id/ai_image"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:src="@drawable/ai_robo_image"
        app:layout_constraintEnd_toStartOf="@+id/textView7"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/one_one_nine_text_button"
        app:layout_constraintTop_toBottomOf="@id/ai_text_view" />

    <TextView
        android:id="@+id/three_five_nine_button"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="Buy Lifetime $359.999"
        android:gravity="center"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/yellow"
        android:background="@drawable/premium_button_background"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@id/ai_image"
        app:layout_constraintTop_toBottomOf="@id/ai_text_view" />


    <TextView
        android:id="@+id/bonus_ai_life_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/three_five_nine_button"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="Bonus 1,000 AR"
       app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_20sdp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/_12sdp"/>


    <TextView
        android:id="@+id/more_info_button_three"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/more_info_text"
        android:elevation="2dp"
        android:textColor="@color/appBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ai_image" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/bonus_ai_year"
        app:layout_constraintTop_toBottomOf="@id/ai_text_view"
        android:background="#99090808"
        android:gravity="center"
        android:textColor="@color/pureWhite"
        android:text="COMING SOON"
        android:textStyle="bold"
        android:textSize="@dimen/_20sdp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
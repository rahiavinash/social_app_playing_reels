<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:backgroundTint="@color/bottomsheet_bg_color"
        tools:context=".mainui.dialogFragments.RemindMeBottomSheet">


        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="Remind me again after:"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
         />

        <TextView
            android:id="@+id/tvMints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="60 mins"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:layout_marginTop="@dimen/_21sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            />


        <TextView
            android:id="@+id/tvNever"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="Never"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:layout_marginTop="@dimen/_21sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/_26sdp"
            app:layout_constraintTop_toBottomOf="@+id/tvMints"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
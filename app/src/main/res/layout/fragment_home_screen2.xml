        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/postFragment"
            android:layout_width="match_parent"
            android:nestedScrollingEnabled="true"
            android:name="com.wedo8020.app.mainui.home.postFragment.PostScreen"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


        <LinearLayout
            android:layout_marginTop="@dimen/_12sdp"
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:weightSum="5"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/textAr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ar"
                        android:textAllCaps="true"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/appBlue"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="@id/glVerticalStart"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/arCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:text="0.0"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toEndOf="@id/textAr"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        app:tint="@color/pureWhite"
                        android:src="@drawable/ic_tree"/>
                    <TextView
                        android:id="@+id/arTreeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:text="0"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toEndOf="@id/textAr"
                        app:layout_constraintTop_toTopOf="parent"/>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3">
                <!--<LinearLayout
                    android:id="@+id/friendBtn"
                    android:layout_width="0dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">
                    <ImageView
                        android:id="@+id/friendTabImg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/unselectedColor"
                        android:src="@drawable/ic_friends"/>
                    <TextView
                        android:id="@+id/friendTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/friends"
                        android:textSize="@dimen/_10sdp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/pureWhite"
                        android:visibility="gone"/>
                </LinearLayout>-->
                <LinearLayout
                    android:id="@+id/dropBtn"
                    android:layout_width="0dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1.5"
                    android:gravity="center_horizontal">
                    <ImageView
                        android:id="@+id/dropsTabImg"
                        android:layout_width="36dp"
                        android:layout_height="36dp"

                        android:src="@drawable/ic_drop"/>
                    <TextView
                        android:id="@+id/dropTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_18sdp"
                        android:text="@string/drops"
                        android:textSize="@dimen/_10sdp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/pureWhite"
                        android:visibility="visible"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/followingBtn"
                    android:layout_width="0dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1.5"
                    android:gravity="center_horizontal">
                    <ImageView
                        android:id="@+id/followingTabImg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/unselectedColor"
                        android:src="@drawable/ic_following"/>
                    <TextView
                        android:id="@+id/followingTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/following"
                        android:textSize="@dimen/_10sdp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/pureWhite"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_weight="1"
                android:gravity="end">
                <ImageView
                    android:id="@+id/search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_search"
                    app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>

        </LinearLayout>
        <ImageView
            android:id="@+id/aiBtn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ai_img"
            android:layout_marginTop="-6dp"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
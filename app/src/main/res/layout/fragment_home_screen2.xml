                            android:drawableTop="@drawable/radio_selector"
                            android:contentDescription="24h"
                            android:text="@string/_24_hrs"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#ffffff"
                            android:paddingTop="8dp"
                            android:background="?android:attr/selectableItemBackground"/>



                        <RadioButton
                            android:id="@+id/hrs48Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:drawableTop="@drawable/radio_selector"
                            android:contentDescription="48h"
                            android:text="@string/_48_hrs"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#ffffff"
                            android:paddingTop="8dp"
                            android:background="?android:attr/selectableItemBackground"/>


                        <RadioButton
                            android:id="@+id/week1Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:drawableTop="@drawable/radio_selector"
                            android:contentDescription="1w"
                            android:text="@string/_1_week"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#ffffff"
                            android:paddingTop="8dp"
                            android:background="?android:attr/selectableItemBackground"/>

                        <RadioButton
                            android:id="@+id/mnth1Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:drawableTop="@drawable/radio_selector"
                            android:contentDescription="1m"
                            android:text="@string/_1_month"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#ffffff"
                            android:paddingTop="8dp"
                            android:background="?android:attr/selectableItemBackground"/>


                        <RadioButton
                            android:id="@+id/mnth3Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:drawableTop="@drawable/radio_selector"
                            android:contentDescription="3m"
                            android:text="@string/_3_months"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#ffffff"
                            android:paddingTop="8dp"
                            android:background="?android:attr/selectableItemBackground"/>


<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingClass">

    <data>

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bottom_sheet_background"
            tools:context=".mainui.home.profiletab.bottomSheet.Tag_Collab_BottomSheet_Fragment">


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glVerticalStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.06" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glVerticalEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.94" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTaggedPerson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toStartOf="@+id/glVerticalEnd"
                app:layout_constraintStart_toStartOf="@+id/glVerticalStart"
                app:layout_constraintTop_toTopOf="parent"
                tools:listitem="@layout/tag_profile_recycleview" />


            <androidx.cardview.widget.CardView
                android:id="@+id/searchCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_70sdp"
                app:cardBackgroundColor="@color/bottomsheet_bg_color"
                app:cardCornerRadius="@dimen/_30sdp"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12sdp">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/Grey" />

                    <EditText
                        android:id="@+id/searchEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/transparent"
                        android:fontFamily="@font/poppins"
                        android:hint="@string/search_hint"
                        android:maxLines="1"
                        android:padding="@dimen/_7sdp"
                        android:textColor="@color/pureWhite"
                        android:textColorHint="@color/Grey"
                        android:textSize="@dimen/_11sdp" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- <ImageView
                 android:id="@+id/ivSearhClose"
                 android:layout_width="40dp"
                 android:layout_height="40dp"
                 android:src="@drawable/ic_round_pin"
                 android:padding="10dp"
                 android:tint="@color/white"

                 android:layout_marginEnd="20dp"
                 app:layout_constraintBottom_toBottomOf="@+id/searchCard"
                 app:layout_constraintEnd_toEndOf="@+id/searchCard"
                 app:layout_constraintTop_toTopOf="@+id/searchCard" />-->
            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:visibility="gone"
                android:text="Collab user will be able to post this to their followers "
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchCard" />


            <TextView
                android:id="@+id/tvcollab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:layout_marginEnd="@dimen/_9sdp"
                android:text="tag"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />

            <!--   <TextView
                   android:id="@+id/tvTag"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="@dimen/_9sdp"
                   android:text="tag"

                   android:layout_marginEnd="@dimen/_8sdp"
                   android:textColor="@color/white"
                   app:layout_constraintEnd_toStartOf="@+id/tvcollab"
                   app:layout_constraintTop_toBottomOf="@+id/textView4" />
   -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/linearLayout8"
                android:layout_width="0dp"
                android:layout_height="@dimen/_310sdp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/glVerticalEnd"
                app:layout_constraintStart_toStartOf="@+id/glVerticalStart"
                app:layout_constraintTop_toBottomOf="@+id/tvcollab">

             <!--   <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:paddingBottom="@dimen/_minus60sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">-->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFriend"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_95sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:listitem="@layout/tag_and_collab_select_recycleview" />

<!--                </androidx.core.widget.NestedScrollView>-->



            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_40sdp"
                android:text="@string/no_result_found"
                android:textColor="@color/Grey"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/linearLayout8" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animationView"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_100sdp"
                android:layout_marginTop="@dimen/_50sdp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/round" />

            <LinearLayout
                android:id="@+id/linearLayout7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black"
                android:orientation="vertical"
                android:padding="@dimen/_11sdp"
                app:layout_constraintBottom_toBottomOf="@+id/linearLayout8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvDone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_39sdp"
                    android:layout_marginStart="@dimen/_43sdp"
                    android:layout_marginEnd="@dimen/_43sdp"
                    android:layout_marginBottom="@dimen/_25sdp"
                    android:background="@drawable/blue_background"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="@dimen/_3sdp"
                    android:text="Done"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTag" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:id="@+id/animationLoader"
                app:layout_constraintBottom_toTopOf="@+id/linearLayout7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4">

                <com.airbnb.lottie.LottieAnimationView

                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/round" />
            </androidx.constraintlayout.widget.ConstraintLayout>



            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animationPaginationLoader"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                app:layout_constraintBottom_toTopOf="@+id/linearLayout7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:visibility="gone"
                app:lottie_rawRes="@raw/round" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</layout>
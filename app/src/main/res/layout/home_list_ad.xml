             android:padding="1.5dp"
             android:src="@drawable/subway"
             app:layout_constraintStart_toStartOf="@id/gStart"
             app:layout_constraintTop_toTopOf="parent" />

        <TextView
             android:layout_width="0dp"
             android:layout_height="wrap_content"

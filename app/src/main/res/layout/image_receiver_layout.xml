<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clReceiveMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black">

        <RelativeLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.apachat.swipereveallayout.core.SwipeLayout
                android:id="@+id/SwipeReveal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dragEdge="left"
                app:mode="same_level">

                <LinearLayout
                    android:id="@+id/rlSwipeDeleteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#00000000">

                    <ImageView
                        android:id="@+id/deleteMsg"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_reply_back" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clUserDp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/black"
                    android:elevation="0dp"
                    app:layout_constraintStart_toStartOf="parent">

                     <ImageView
                        android:id="@+id/postNotFound"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:textColor="@color/white"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/llImage"
                        app:layout_constraintEnd_toEndOf="@+id/llImage"
                        app:layout_constraintStart_toStartOf="@+id/llImage"
                        app:layout_constraintTop_toTopOf="parent" />
                    <LinearLayout
                        android:id="@+id/llImage"
                        android:layout_width="@dimen/_110sdp"
                        android:layout_height="@dimen/_160sdp"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="RtlSymmetry">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvImages"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@color/lightblack2"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/receiveOtherImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/reactionLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="-4dp"
                        android:background="@drawable/reaction_white_background"
                        android:elevation="1dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/_2sdp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/llImage">

                        <TextView
                            android:id="@+id/emoji1"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/_2sdp"
                            android:layout_marginEnd="@dimen/_2sdp"
                            android:text="😜"
                            android:textColor="#fff"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/emoji2"
                            android:layout_width="25dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="@dimen/_2sdp"
                            android:text="😜"
                            android:textColor="#fff"
                            android:textSize="20sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/clUserDp"
                        android:fontFamily="@font/poppins"
                        android:textAllCaps="true"

                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_9sdp"
                        app:layout_constraintEnd_toEndOf="@+id/llImage"
                        app:layout_constraintTop_toBottomOf="@+id/llImage" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_toEndOf="@+id/clUserDp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:textColor="@color/Grey2"
                    android:textSize="@dimen/_11sdp" />


                <!--<androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageLayout"
            android:layout_width="wrap_content"
            android:layout_toEndOf="@+id/clUserDp"
            android:layout_below="@+id/tvUserName"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/reactionLayout"
                android:layout_width="26dp"
                android:elevation="1dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_height="26dp"
                >

                <androidx.cardview.widget.CardView
                    android:id="@+id/greyCircle"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="0.5dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/Grey2"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/whiteCircle"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="1.5dp"
                    android:layout_marginBottom="1.5dp"
                    app:cardBackgroundColor="@color/Grey2"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="😜"
                            android:textColor="#fff"
                            android:textSize="15dp" />

                    </androidx.cardview.widget.CardView>


                </androidx.cardview.widget.CardView>


            </RelativeLayout>




            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:layout_marginBottom="5dp"
                android:paddingEnd="10dp"
                >

                <LinearLayout
                    android:id="@+id/image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="@color/Grey2"
                        >

                        <ImageView
                            android:id="@+id/receiveImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>


            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>-->


            </com.apachat.swipereveallayout.core.SwipeLayout>

        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
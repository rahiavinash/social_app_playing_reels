<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".mainui.login.SelfCertificationFragment">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root"
        android:background="@color/black">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root1"
        android:background="@color/black">





        <TextView
            android:id="@+id/account_created_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Account created"
            android:textSize="@dimen/_16sdp"
            android:textColor="#DEDEDE"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_10sdp"/>


        <TextView
            android:id="@+id/forget_user_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:text="If you forget your username or \npassword you will need the\n code below\n\nPlease save it.."
            android:textSize="@dimen/_16sdp"
            android:textColor="#DEDEDE"
            app:layout_constraintTop_toBottomOf="@id/account_created_text"
            android:layout_marginTop="@dimen/_60sdp"/>

        <TextView
            android:id="@+id/not_recovered_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="@dimen/_50sdp"
            android:layout_marginEnd="@dimen/_50sdp"
            android:text="WITHOUT THIS CODE YOUR\n ACCOUNT CAN NOT BE\n RECOVERED."
            android:textSize="@dimen/_16sdp"
            android:textColor="#0AB210"
            app:layout_constraintTop_toBottomOf="@id/forget_user_name_text"
            android:layout_marginTop="@dimen/_30sdp"/>

        <TextView
            android:id="@+id/recovery_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:text="sssssssssssssssssssssssssssss"
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/not_recovered_name_text"
            android:layout_marginTop="@dimen/_60sdp"/>

        <TextView
            android:id="@+id/copy_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:fontFamily="@font/poppins_semibold"
            android:text="SAVE CODE"
            android:textSize="@dimen/_22sdp"
            android:textColor="#2E94D2"
            app:layout_constraintTop_toBottomOf="@id/recovery_code"
            android:layout_marginTop="@dimen/_10sdp"/>



        <TextView
            android:id="@+id/done_button"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_35sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_40sdp"
            android:text="Next"
            android:paddingTop="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_80sdp"
            android:fontFamily="@font/poppins_semibold"
            android:background="@drawable/white_button_background_two"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/Grey"
            app:layout_constraintTop_toBottomOf="@id/copy_code"
            android:layout_marginBottom="@dimen/_40sdp"/>




    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

<?xml version="1.0" encoding="utf-8"?>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/upload_background">





        <TextView
            android:id="@+id/uploadText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/uploadText"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_15sdp"/>



        <TextView
            android:id="@+id/videoUptoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/videoTextView"
            app:layout_constraintTop_toBottomOf="@id/uploadText"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_2sdp"
            />

        <ImageView
            android:id="@+id/imageIcon"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/_70sdp"
            android:layout_marginBottom="@dimen/_150sdp"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@drawable/image_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/imageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/_75sdp"
            app:layout_constraintTop_toBottomOf="@id/imageIcon"
            android:text="Photo"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/white"/>

        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="70dp"
            android:layout_height="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_marginEnd="@dimen/_70sdp"
            android:src="@drawable/video_icon"
            android:layout_marginStart="@dimen/_50sdp"
            android:layout_marginBottom="@dimen/_150sdp"/>

        <TextView
            android:id="@+id/VideoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/_75sdp"
            app:layout_constraintTop_toBottomOf="@id/videoIcon"
            android:text="Video"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root"
        android:background="@color/black">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="25dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:src="@drawable/back"/>

        <TextView
            android:id="@+id/create_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Create"
            android:textSize="@dimen/_15sdp"
            android:textColor="#DEDEDE"
            app:layout_constraintTop_toTopOf="@id/back_button" />

        <TextView
            android:id="@+id/we_do_text"
            android:layout_width="@dimen/_220sdp"
            android:layout_height="@dimen/_40sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="WeDo 80 IS CURRENTLY\n AT FULL CAPACITY"
            android:textSize="@dimen/_17sdp"
            android:textColor="#A9A9A9"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/create_text"
            android:layout_marginTop="@dimen/_30sdp"/>

        <TextView
            android:id="@+id/check_text"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Please check back in a week or two."
            android:textSize="@dimen/_16sdp"
            android:textColor="#A9A9A9"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/we_do_text"
            android:layout_marginTop="@dimen/_20sdp"/>


        <TextView
            android:id="@+id/working_text"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="We are working hard to get you started as soon as possible"
            android:textSize="@dimen/_17sdp"
            android:textColor="#A9A9A9"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/check_text"
            android:layout_marginTop="@dimen/_20sdp"/>


        <TextView
            android:id="@+id/worth_text"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="@dimen/_40sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="It's worth the wait"
            android:textSize="@dimen/_17sdp"
            android:textColor="#0AB210"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/working_text"
            android:layout_marginTop="@dimen/_30sdp"/>


        <TextView
            android:id="@+id/ok_button"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_35sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_40sdp"
            android:text="Ok"
            android:paddingTop="4dp"
            android:textStyle="bold"
            android:background="@drawable/blue_button_background_two"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/white"
            android:layout_marginBottom="@dimen/_30sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/_100sdp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

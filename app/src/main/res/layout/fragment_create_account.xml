<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">


    <ImageView
        android:id="@+id/back_button"
        android:layout_width="25dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:src="@drawable/back"/>


        <TextView
            android:id="@+id/create_account_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Create Account"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/back_button" />

        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Welcome to WeDo 80"
            android:textSize="@dimen/_15sdp"
            android:gravity="center"
            android:fontFamily="@font/poppins"
            android:textColor="#A9A9A9"
            app:layout_constraintTop_toBottomOf="@id/create_account_text"
            android:layout_marginTop="@dimen/_30sdp"/>

        <TextView
            android:id="@+id/respect_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:text="We respect your privacy.\n\nWe don’t need to know\nany personal details."
            android:textSize="@dimen/_14sdp"
            android:textColor="#0AB210"
            app:layout_constraintTop_toBottomOf="@id/welcome_text"
            android:layout_marginTop="@dimen/_60sdp"/>


        <TextView
            android:id="@+id/before_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:padding="@dimen/_2sdp"
            android:lineSpacingExtra="@dimen/_5sdp"
            android:fontFamily="@font/poppins"
            android:text="Before you start using WeDo 80, we\n need to confirm that you are of\n appropriate age according to your\n country's legal requirements and\n that you agree to our Terms of Use\n and Privacy Policy."
            android:textSize="@dimen/_12sdp"
            android:textColor="#A9A9A9"
            android:includeFontPadding="true"
            app:layout_constraintTop_toBottomOf="@id/respect_text"
            android:layout_marginTop="@dimen/_60sdp"/>


        <TextView
            android:id="@+id/next_button"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_35sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_60sdp"
            android:text="Next"
            android:paddingTop="4dp"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:background="@drawable/blue_button_background_two"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/_40sdp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>


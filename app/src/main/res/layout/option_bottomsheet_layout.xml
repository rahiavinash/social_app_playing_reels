<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bottomsheet_bg_color">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glVerticalStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glVerticalEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.94" />

        <LinearLayout
            android:id="@+id/ghostModeBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="1"
            android:paddingVertical="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_ghost"
                android:layout_weight=".22" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ghost_mode"
                android:layout_weight=".78"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/swapBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="1"
            android:paddingVertical="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
            app:layout_constraintTop_toBottomOf="@+id/ghostModeBtn">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_swap"
                android:layout_weight=".22" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/swap_lh_rh"
                android:textSize="@dimen/_12sdp"
                android:layout_weight=".78"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloadBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="1"
            android:paddingVertical="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
            app:layout_constraintTop_toBottomOf="@+id/swapBtn">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_download"
                android:layout_weight=".22" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight=".78"
                android:layout_height="wrap_content"
                android:text="@string/download"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ownPostOptions"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
            app:layout_constraintTop_toBottomOf="@+id/downloadBtn"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/editBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/downloadBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_edit"
                    android:layout_weight=".22"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".78"
                    android:text="@string/edit"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/archiveBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/editBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_archive"
                    android:layout_weight=".22"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".78"
                    android:text="@string/archive"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/deleteBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/archiveBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_delete"
                    android:layout_weight=".22"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".78"
                    android:text="@string/delete"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/otherPostOption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
            app:layout_constraintTop_toBottomOf="@+id/downloadBtn"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/repostBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:visibility="gone"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/downloadBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_repost"
                    android:layout_weight=".22"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".78"
                    android:text="@string/repost"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/notInterestedBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/repostBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_not_interested"
                    android:layout_weight=".32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_interested"
                    android:textSize="@dimen/_12sdp"

                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/icRestrictBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/notInterestedBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_restrict"
                    android:layout_weight=".22" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".78"
                    android:text="@string/retrict_text"
                    android:textSize="@dimen/_12sdp"

                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reportBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toEndOf="@id/glVerticalStart"
                app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                app:layout_constraintTop_toBottomOf="@+id/icRestrictBtn">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_flag"
                    app:tint="@color/RedColor"

                    android:layout_weight=".22" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".78"
                    android:text="@string/report_post"
                    android:textSize="@dimen/_12sdp"

                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/RedColor" />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/post_info_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/glVerticalEnd">

            <ImageView
                android:id="@+id/iv_post_info"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tint="@color/appBlue"
                android:src="@drawable/ic_post_info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_info"
                android:paddingTop="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_5sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_post_info"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="@dimen/_12sdp"

                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/appBlue" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/other_user_option"
            android:layout_width="0dp"
            android:visibility="gone"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/glVerticalStart"
            app:layout_constraintEnd_toEndOf="@id/glVerticalEnd"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/btn_share_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    app:tint="@color/black"
                    android:src="@drawable/ic_share"
                    android:layout_weight=".22" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/share_profile"
                    android:layout_weight=".78"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/black" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_share_profile">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_blocks"
                    android:layout_weight=".22" />

                <TextView
                    android:id="@+id/tv_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/block"
                    android:textSize="@dimen/_12sdp"
                    android:layout_weight=".78"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/RedColor" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_report"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_block">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_flag"
                    app:tint="@color/black"
                    android:layout_weight=".22" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight=".78"
                    android:layout_height="wrap_content"
                    android:text="@string/report"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/black" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
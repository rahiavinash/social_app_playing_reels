<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/buy_background_src"
    tools:context=".mainui.home.exchangescreen.BuySrcFragment">

    <ImageView
        android:id="@+id/back_button"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/back"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_25sdp"/>
    <ImageView
        android:id="@+id/coin_image"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_60sdp"
        android:src="@drawable/coin_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/more_info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/more_info_text"
        android:textColor="@color/appBlue"
        android:fontFamily="@font/poppins"
        app:layout_constraintTop_toBottomOf="@id/coin_image"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"/>



    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="10dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="10dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/buy_src_button_back_ground"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/more_info_text">

        <TextView
            android:id="@+id/buyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_text"
            android:textColor="@color/pureWhite"
            android:textSize="@dimen/_15sdp"
            android:gravity="center"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/one_src"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1 SRC"
            android:textColor="#FFE059"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_17sdp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nine_dollar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="₹ 999.00"
            android:textColor="@color/pureWhite"
            android:textSize="@dimen/_15sdp"
            android:fontFamily="@font/poppins"
            app:layout_goneMarginEnd="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_17sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/_10sdp" />




    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_one"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/_60sdp"
        android:background="@drawable/buy_src_image_back_ground"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/constraint_layout">

        <TextView
            android:id="@+id/buy_text_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_text"
            android:gravity="center"
            android:textColor="@color/pureWhite"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_17sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintHorizontal_bias="0.5"
            />

        <TextView
            android:id="@+id/five_src"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 SRC"
            android:gravity="center"
            android:textColor="#FFE059"
            android:textSize="@dimen/_15sdp"
            android:fontFamily="@font/poppins"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_17sdp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/forty_four_dollar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="₹ 4,999.00"
            android:textColor="@color/pureWhite"
            android:textSize="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/poppins"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/_10sdp"/>




    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_two"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/_60sdp"
        android:background="@drawable/buy_src_image_back_ground"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/constraint_layout_one">

        <TextView
            android:id="@+id/buy_text_three"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/poppins"
            android:text="@string/buy_text"
            android:gravity="center"
            android:textColor="@color/pureWhite"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ten_src"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="10 SRC"
            android:textColor="#FFE059"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nine_nine_nine_seven_nine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:gravity="center"
            android:fontFamily="@font/poppins"
            android:text="₹ 7,900.00"
            android:textColor="@color/pureWhite"
            android:textSize="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>



    </androidx.constraintlayout.widget.ConstraintLayout>













</androidx.constraintlayout.widget.ConstraintLayout>
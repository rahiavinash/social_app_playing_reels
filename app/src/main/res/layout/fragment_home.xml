<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pureBlack"
        tools:context=".mainui.home.HomeFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glVerticalStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.02" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glVerticalEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.98" />

        <com.wedo8020.app.mainui.customView.CustomViewPager
            android:id="@+id/postTypePageView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:nestedScrollingEnabled="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:weightSum="5"
            app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
            app:layout_constraintStart_toEndOf="@id/glVerticalStart"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/textAr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="@string/ar"
                        android:textAllCaps="true"
                        android:textColor="@color/appBlue"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="@id/glVerticalStart"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/arCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:fontFamily="@font/poppins"
                        android:textAllCaps="true"
                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toEndOf="@id/textAr"
                        app:layout_constraintTop_toTopOf="parent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/ic_tree"
                        app:tint="@color/pureWhite" />

                    <TextView
                        android:id="@+id/arTreeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:fontFamily="@font/poppins"
                        android:textAllCaps="true"
                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toEndOf="@id/textAr"
                        app:layout_constraintTop_toTopOf="parent" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3">



                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dropBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:layout_marginEnd="@dimen/_13sdp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dropsTabImg"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:layout_constraintStart_toStartOf="@id/dropTabText"
                        app:layout_constraintEnd_toEndOf="@id/dropTabText"
                        app:layout_constraintBottom_toTopOf="@id/dropTabText"
                        android:src="@drawable/ic_drop" />

                    <TextView
                        android:id="@+id/dropTabText"
                        android:layout_width="@dimen/_55sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/drops"
                        android:gravity="center"
                        android:textColor="@color/pureWhite"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"

                        android:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/followingBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:layout_marginStart="@dimen/_13sdp"

                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/followingTabImg"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_following"
                        app:layout_constraintBottom_toTopOf="@id/followingTabText"
                        app:layout_constraintStart_toStartOf="@id/followingTabText"
                        app:layout_constraintEnd_toEndOf="@id/followingTabText"
                        app:tint="@color/tabUnselected" />

                    <TextView
                        android:id="@+id/followingTabText"
                        android:layout_width="@dimen/_55sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/following"
                        android:gravity="center"
                        android:textColor="@color/tabUnselected"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_weight="1"
                android:gravity="end">

                <ImageView
                    android:id="@+id/search"
                    android:layout_width="33dp"

                    android:layout_height="33dp"
                    android:src="@drawable/ic_search"
                    app:layout_constraintEnd_toStartOf="@id/glVerticalEnd"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
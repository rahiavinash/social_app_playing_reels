<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:background="@color/card_notification_color"
    android:layout_height="wrap_content">



    <LinearLayout
        android:id="@+id/llUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_7sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_7sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/relativeLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivRestrictImage"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_greyuser"
                android:visibility="gone" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivUserProfileImage"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_greyuser" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp" />

                    <ImageView
                        android:id="@+id/ivBlueTick"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:layout_gravity="end"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@id/tvName"
                        android:src="@drawable/bluetick"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent" />


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp" />

                    <ImageView
                        android:id="@+id/likeImage"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@id/name"
                        android:src="@drawable/ic_like"
                        android:visibility="gone" />
                </RelativeLayout>


            </LinearLayout>

            <TextView
                android:id="@+id/tvFollow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center_vertical"
                android:padding="@dimen/_5sdp"
                android:text="@string/follow"
                android:textColor="@color/appBlue"
                android:textSize="@dimen/_9sdp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/_35sdp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_5sdp">

                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/LightBlack"
                    android:textSize="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <ImageView
                android:id="@+id/ivHearts"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center_vertical"
                android:padding="@dimen/_2sdp"
                android:visibility="invisible"
                android:src="@drawable/ic_like"
                android:text="@string/un_report"
                android:textColor="@color/LightBlack"
                android:textSize="@dimen/_11sdp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
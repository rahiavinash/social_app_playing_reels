<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DialogStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.DynamicColors.DayNight" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.DynamicColors.DayNight" />

    <style name="BottomNavigation">
        <item name="android:background">@android:color/background_light</item>

    </style>

    <style name="CustomTabLayoutText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="textFillColor">@color/LightBlack</item>
        <item name="android:fontFamily">@font/poppins_medium</item><!-- Change text size as needed -->
    </style>
    <style name="MyDropdownMenuStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <item name="android:popupBackground">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="CustomTabLayoutTexts" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/Grey</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <!-- Add other text attributes as needed -->
    </style>

    <style name="SelectedTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/LightBlack</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <!-- Add other text attributes as needed -->
    </style>


</resources>
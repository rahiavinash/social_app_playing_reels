<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:dither="true" android:shape="rectangle" android:useLevel="false" android:visible="true">
            <solid android:color="@color/appBlue" />
            <corners android:radius="20dp" />
            <size android:width="48dp" android:height="24dp" />
            <padding android:right="@dimen/_1sdp" android:left="@dimen/_1sdp" android:top="@dimen/_2sdp" android:bottom="@dimen/_2sdp"/>        </shape>
    </item>
    <item android:state_checked="false" >
        <shape android:dither="true" android:shape="rectangle" android:useLevel="false" android:visible="true">
            <solid android:color="@color/LightGrey" />
            <corners android:radius="20dp" />
            <size android:width="48dp" android:height="24dp" />
            <padding android:right="@dimen/_1sdp" android:left="@dimen/_1sdp" android:top="@dimen/_2sdp" android:bottom="@dimen/_2sdp"/>
        </shape>
    </item>
</selector>
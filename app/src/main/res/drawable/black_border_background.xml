<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background shape -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EFEFEF"/>
           />
        </shape>
    </item>

    <!-- Black border -->
    <item android:top="0.5dp" android:right="0.5dp"
        android:bottom="0.5dp" android:left="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="1dp"
                android:color="#000000" /> <!-- Set the color to black (#000000) or any other color -->
        </shape>
    </item>
</layer-list>

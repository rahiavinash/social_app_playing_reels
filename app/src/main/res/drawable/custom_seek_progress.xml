        <shape>

            <solid android:color="#A9A9A9" /> <!-- Background color (light gray) -->
        </shape>
    </item>
    <item android:id="@android:id/progress" >
        <clip>
            <shape>
                <solid android:color="#FFFFFF" /> <!-- Progress color (white) -->
            </shape>
        </clip>
    </item>
</layer-list>
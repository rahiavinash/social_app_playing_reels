<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >
    <item android:id="@android:id/background" android:height="@dimen/_4sdp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/progressBackgroundColor" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:height="@dimen/_4sdp"
        android:gravity="center">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/progressColor" />
            </shape>
        </clip>
    </item>
</layer-list>